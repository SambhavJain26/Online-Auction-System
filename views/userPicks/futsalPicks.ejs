<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Futsal Roster Picks - Online Auction System</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-[#F8FAFC] min-h-screen flex flex-col justify-between">

  <!-- Header -->
  <header class="w-full bg-[#1E293B] text-white px-8 py-4 flex justify-between items-center shadow-md">
    <div class="flex items-center gap-4">
      <a href="/users/yourPicks" class="px-4 py-2 bg-[#EB5E28] hover:bg-[#d44f1c] text-white rounded-lg font-semibold text-xs transition shadow-sm">
        &larr; Back to Picks Hub
      </a>
      <span class="text-slate-400">|</span>
      <h1 class="text-xl font-bold tracking-tight text-white">Futsal League Roster</h1>
    </div>
    <a href="/users" class="px-3.5 py-1.5 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-lg font-medium text-xs transition">
      Franchise Arena
    </a>
  </header>

  <!-- Main Roster Showcase -->
  <main class="max-w-7xl mx-auto px-6 py-10 flex-1 w-full">
    <div class="text-center max-w-xl mx-auto mb-10">
      <span class="inline-block px-3 py-1 bg-emerald-100 text-emerald-800 text-xs font-bold rounded-full mb-2 uppercase tracking-wider">
        Confirmed Acquisitions
      </span>
      <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">Your Acquired Futsal Athletes</h2>
      <p class="text-slate-500 text-sm mt-1">Review the players secured by your franchise during completed auction cycles.</p>
    </div>

    <% if (players.length === 0) { %>
      <div class="bg-white border border-slate-200 rounded-2xl p-12 text-center max-w-md mx-auto shadow-sm">
        <div class="text-4xl mb-3">⚽</div>
        <h3 class="text-lg font-bold text-slate-800">No Players Acquired Yet</h3>
        <p class="text-slate-500 text-xs mt-1">Join an active Futsal bidding session to build your team roster.</p>
        <a href="/users/futsal" class="mt-5 inline-block px-5 py-2.5 bg-[#EB5E28] hover:bg-[#d44f1c] text-white text-xs font-bold uppercase rounded-xl transition">
          Enter Auction Room &rarr;
        </a>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        <% players.forEach(player => { %>
          <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition">
            <div class="w-full h-52 bg-slate-900 overflow-hidden relative">
              <img src="/imgs/uploads/<%= player.profilepic %>" onerror="this.src='/imgs/uploads/futsal_01.png'" alt="<%= player.name %>" class="w-full h-full object-cover">
              <div class="absolute top-3 right-3 bg-emerald-500 text-white text-[10px] font-extrabold px-2.5 py-1 rounded-full uppercase tracking-wider">
                Signed
              </div>
            </div>
            <div class="p-5">
              <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-600 block mb-1">Futsal League</span>
              <h3 class="text-lg font-extrabold text-slate-900"><%= player.name %></h3>
              <p class="text-slate-500 text-xs mt-1 leading-relaxed"><%= player.description %></p>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

  </main>

  <footer class="py-4 text-center text-xs text-slate-400 border-t border-slate-200 bg-white">
    Sports Auction Arena: Automated Rostering System
  </footer>

</body>
</html>
