<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Picks Hub - Online Auction System</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-[#F8FAFC] min-h-screen flex flex-col justify-between">

  <!-- Header -->
  <header class="w-full bg-[#1E293B] text-white px-8 py-4 flex justify-between items-center shadow-md">
    <div class="flex items-center gap-4">
      <a href="/users" class="px-4 py-2 bg-[#EB5E28] hover:bg-[#d44f1c] text-white rounded-lg font-semibold text-xs transition shadow-sm">
        &larr; Back to Arena
      </a>
      <span class="text-slate-400">|</span>
      <h1 class="text-xl font-bold tracking-tight text-white">Franchise Roster Hub</h1>
    </div>
    <div class="flex items-center gap-3">
      <span class="text-xs text-slate-300 font-medium">Acquisitions Overview</span>
    </div>
  </header>

  <!-- Hero Welcome -->
  <main class="max-w-7xl mx-auto px-6 py-10 flex-1 w-full">
    <div class="text-center max-w-xl mx-auto mb-10">
      <span class="inline-block px-3 py-1 bg-emerald-100 text-emerald-800 text-xs font-bold rounded-full mb-2 uppercase tracking-wider">
        Roster Records
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">Your Acquired Team Rosters</h2>
      <p class="text-slate-500 text-sm mt-1">Select a tournament below to review your contracted athletes and contract disbursements.</p>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">

      <!-- NUPL Card -->
      <div class="bg-white border border-slate-200 hover:border-amber-400 rounded-2xl p-4 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
        <div>
          <div class="w-full h-48 rounded-xl overflow-hidden mb-4 bg-slate-900">
            <img src="/imgs/nupl.jpg" alt="NUPL Cricket" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
          </div>
          <div class="flex items-center justify-between mb-1">
            <h3 class="text-lg font-extrabold text-slate-900">NUPL Cricket</h3>
            <span class="text-[11px] font-bold px-2 py-0.5 bg-amber-50 text-amber-700 border border-amber-200 rounded-full">Cricket</span>
          </div>
          <p class="text-slate-500 text-xs">Review all acquired batsmen, bowlers, and all-rounders.</p>
        </div>
        <a href="/users/nuplPicks" class="mt-5 block w-full py-2.5 bg-slate-900 group-hover:bg-[#EB5E28] text-white text-center rounded-xl font-bold text-xs tracking-wider uppercase transition shadow-sm">
          View NUPL Roster &rarr;
        </a>
      </div>

      <!-- IMPETUS Card -->
      <div class="bg-white border border-slate-200 hover:border-indigo-400 rounded-2xl p-4 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
        <div>
          <div class="w-full h-48 rounded-xl overflow-hidden mb-4 bg-slate-900">
            <img src="/imgs/impetus.jpg" alt="IMPETUS" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
          </div>
          <div class="flex items-center justify-between mb-1">
            <h3 class="text-lg font-extrabold text-slate-900">IMPETUS</h3>
            <span class="text-[11px] font-bold px-2 py-0.5 bg-indigo-50 text-indigo-700 border border-indigo-200 rounded-full">Esports</span>
          </div>
          <p class="text-slate-500 text-xs">Review secured strategy champions and esports leads.</p>
        </div>
        <a href="/users/impetusPicks" class="mt-5 block w-full py-2.5 bg-slate-900 group-hover:bg-[#EB5E28] text-white text-center rounded-xl font-bold text-xs tracking-wider uppercase transition shadow-sm">
          View Impetus Roster &rarr;
        </a>
      </div>

      <!-- FUTSAL Card -->
      <div class="bg-white border border-slate-200 hover:border-sky-400 rounded-2xl p-4 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
        <div>
          <div class="w-full h-48 rounded-xl overflow-hidden mb-4 bg-slate-900">
            <img src="/imgs/futsal.jpg" alt="FUTSAL" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
          </div>
          <div class="flex items-center justify-between mb-1">
            <h3 class="text-lg font-extrabold text-slate-900">FUTSAL</h3>
            <span class="text-[11px] font-bold px-2 py-0.5 bg-sky-50 text-sky-700 border border-sky-200 rounded-full">Indoor Soccer</span>
          </div>
          <p class="text-slate-500 text-xs">Review your indoor soccer forwards, pivots, and goalkeepers.</p>
        </div>
        <a href="/users/futsalPicks" class="mt-5 block w-full py-2.5 bg-slate-900 group-hover:bg-[#EB5E28] text-white text-center rounded-xl font-bold text-xs tracking-wider uppercase transition shadow-sm">
          View Futsal Roster &rarr;
        </a>
      </div>

      <!-- NUKL Card -->
      <div class="bg-white border border-slate-200 hover:border-orange-400 rounded-2xl p-4 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
        <div>
          <div class="w-full h-48 rounded-xl overflow-hidden mb-4 bg-slate-900">
            <img src="/imgs/kabaddi.jpg" alt="NUKL Kabaddi" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
          </div>
          <div class="flex items-center justify-between mb-1">
            <h3 class="text-lg font-extrabold text-slate-900">NUKL</h3>
            <span class="text-[11px] font-bold px-2 py-0.5 bg-orange-50 text-orange-700 border border-orange-200 rounded-full">Kabaddi</span>
          </div>
          <p class="text-slate-500 text-xs">Review your power raiders and iron corner defenders.</p>
        </div>
        <a href="/users/nuklPicks" class="mt-5 block w-full py-2.5 bg-slate-900 group-hover:bg-[#EB5E28] text-white text-center rounded-xl font-bold text-xs tracking-wider uppercase transition shadow-sm">
          View NUKL Roster &rarr;
        </a>
      </div>

    </div>
  </main>

  <footer class="w-full py-4 text-center text-xs text-slate-400 border-t border-slate-200 bg-white">
    Online Auction System &bull; Real-Time League Bidding Platform
  </footer>

</body>
</html>
