<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Franchise Portal - Online Auction System</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-[#F8FAFC] min-h-screen flex flex-col justify-between">

  <!-- Auction Ended Overlay -->
  <div id="auction-ended-overlay" class="hidden fixed inset-0 bg-slate-900/90 backdrop-blur-sm text-white flex flex-col items-center justify-center text-center z-[9999]">
    <div class="bg-slate-800 border border-slate-700 p-8 rounded-2xl max-w-md shadow-2xl">
      <div class="text-4xl mb-3">🏁</div>
      <h1 class="text-2xl font-extrabold text-white">Auction Session Concluded</h1>
      <p class="mt-2 text-sm text-slate-400">The auctioneer has officially closed this bidding session.</p>
      <button onclick="window.location.reload()" class="mt-6 px-6 py-2.5 bg-[#EB5E28] hover:bg-[#d44f1c] text-white rounded-xl font-bold text-sm transition">
        Return to Portal
      </button>
    </div>
  </div>

  <!-- Header -->
  <header class="w-full bg-[#1E293B] text-white px-8 py-4 flex justify-between items-center shadow-md">
    <div class="flex items-center gap-3">
      <img src="/imgs/nu logo.png" alt="Logo" class="w-10 h-10 object-contain rounded-lg">
      <span class="font-extrabold text-xl tracking-tight text-white">FRANCHISE ARENA</span>
    </div>

    <div class="flex items-center gap-4">
      <a href="/users/yourPicks" class="px-4 py-2 bg-[#EB5E28] hover:bg-[#d44f1c] text-white rounded-lg font-semibold text-xs transition shadow-sm flex items-center gap-1.5">
        <span>🏆</span> Your Acquired Picks
      </a>
      <a href="/users/logoutUser" class="px-3.5 py-1.5 bg-slate-800 hover:bg-rose-900/60 text-rose-300 hover:text-white border border-slate-700 rounded-lg font-medium text-xs transition">
        Logout
      </a>
    </div>
  </header>

  <!-- Hero Section -->
  <main class="max-w-7xl mx-auto px-6 py-10 flex-1 w-full">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <span class="inline-block px-3 py-1 bg-emerald-100 text-emerald-800 text-xs font-bold rounded-full mb-3 uppercase tracking-wider">
        Active Franchise Terminal
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Welcome, <%= user.username %>
      </h2>
      <p class="text-slate-500 text-sm mt-2">
        Enter your designated league bidding room below to compete for talent in real time.
      </p>
    </div>

    <!-- League Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">

      <% if (associatedAuctions.includes('nupl')) { %>
        <!-- NUPL Card -->
        <div class="bg-white border border-slate-200 hover:border-amber-400 rounded-2xl p-4 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-full h-48 rounded-xl overflow-hidden mb-4 bg-slate-900">
              <img src="/imgs/nupl.jpg" alt="NUPL Cricket" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
            </div>
            <div class="flex items-center justify-between mb-1">
              <h3 class="text-lg font-extrabold text-slate-900">NUPL</h3>
              <span class="text-[11px] font-bold px-2 py-0.5 bg-amber-50 text-amber-700 border border-amber-200 rounded-full">Cricket</span>
            </div>
            <p class="text-slate-500 text-xs">Premiere cricket tournament bidding room with fast-paced auctions.</p>
          </div>
          <a href="/users/nupl" class="mt-5 block w-full py-2.5 bg-slate-900 group-hover:bg-[#EB5E28] text-white text-center rounded-xl font-bold text-xs tracking-wider uppercase transition shadow-sm">
            Join Live Room &rarr;
          </a>
        </div>
      <% } %>

      <% if (associatedAuctions.includes('impetus')) { %>
        <!-- IMPETUS Card -->
        <div class="bg-white border border-slate-200 hover:border-indigo-400 rounded-2xl p-4 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-full h-48 rounded-xl overflow-hidden mb-4 bg-slate-900">
              <img src="/imgs/impetus.jpg" alt="IMPETUS" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
            </div>
            <div class="flex items-center justify-between mb-1">
              <h3 class="text-lg font-extrabold text-slate-900">IMPETUS</h3>
              <span class="text-[11px] font-bold px-2 py-0.5 bg-indigo-50 text-indigo-700 border border-indigo-200 rounded-full">Esports</span>
            </div>
            <p class="text-slate-500 text-xs">Tactical mind games, strategy champions, and competitive esports.</p>
          </div>
          <a href="/users/impetus" class="mt-5 block w-full py-2.5 bg-slate-900 group-hover:bg-[#EB5E28] text-white text-center rounded-xl font-bold text-xs tracking-wider uppercase transition shadow-sm">
            Join Live Room &rarr;
          </a>
        </div>
      <% } %>

      <% if (associatedAuctions.includes('futsal')) { %>
        <!-- FUTSAL Card -->
        <div class="bg-white border border-slate-200 hover:border-sky-400 rounded-2xl p-4 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-full h-48 rounded-xl overflow-hidden mb-4 bg-slate-900">
              <img src="/imgs/futsal.jpg" alt="FUTSAL" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
            </div>
            <div class="flex items-center justify-between mb-1">
              <h3 class="text-lg font-extrabold text-slate-900">FUTSAL</h3>
              <span class="text-[11px] font-bold px-2 py-0.5 bg-sky-50 text-sky-700 border border-sky-200 rounded-full">Indoor Soccer</span>
            </div>
            <p class="text-slate-500 text-xs">High-tempo indoor football tournament with dynamic roster bidding.</p>
          </div>
          <a href="/users/futsal" class="mt-5 block w-full py-2.5 bg-slate-900 group-hover:bg-[#EB5E28] text-white text-center rounded-xl font-bold text-xs tracking-wider uppercase transition shadow-sm">
            Join Live Room &rarr;
          </a>
        </div>
      <% } %>

      <% if (associatedAuctions.includes('nukl')) { %>
        <!-- NUKL Card -->
        <div class="bg-white border border-slate-200 hover:border-orange-400 rounded-2xl p-4 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-full h-48 rounded-xl overflow-hidden mb-4 bg-slate-900">
              <img src="/imgs/kabaddi.jpg" alt="NUKL Kabaddi" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
            </div>
            <div class="flex items-center justify-between mb-1">
              <h3 class="text-lg font-extrabold text-slate-900">NUKL</h3>
              <span class="text-[11px] font-bold px-2 py-0.5 bg-orange-50 text-orange-700 border border-orange-200 rounded-full">Kabaddi</span>
            </div>
            <p class="text-slate-500 text-xs">High-intensity contact kabaddi draft with top raiders and defenders.</p>
          </div>
          <a href="/users/nukl" class="mt-5 block w-full py-2.5 bg-slate-900 group-hover:bg-[#EB5E28] text-white text-center rounded-xl font-bold text-xs tracking-wider uppercase transition shadow-sm">
            Join Live Room &rarr;
          </a>
        </div>
      <% } %>

    </div>
  </main>

  <!-- Footer -->
  <footer class="w-full py-4 text-center text-xs text-slate-400 border-t border-slate-200 bg-white">
    Online Auction System &bull; Real-Time League Bidding Platform
  </footer>

</body>
</html>
