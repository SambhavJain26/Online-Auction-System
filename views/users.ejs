<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="../css/style.css">
</head>
<body class="bg-[#FFFCF2]">
  <div id="auction-ended-overlay" class="hidden fixed inset-0 bg-black bg-opacity-80 text-white flex flex-col items-center justify-center text-center z-[9999]">
    <h1 class="text-4xl font-bold">The auction was ended by the host.</h1>
    <p class="mt-4 text-lg text-2xl">Please reload the site</p> 
  </div>
  

  <div class="w-full bg-[#403D39] p-6 flex justify-between items-center text-[#FFFCF2]">
    <div class="flex items-center">
      <img src="../imgs/nu logo.png" alt="Nu logo" class="w-20 h-10 object-cover mr-2">
      <div class="font-bold pr-10 text-2xl">NU AUCTION SYSTEM</div>
    </div>
    <div class="flex">
      <div class="ml-10 bg-[#EB5E28] py-2 px-4 rounded-lg text-white font-semibold  text-lg">
        <a href="/users/yourPicks">Your Picks</a>
      </div>
      <div>
        <a href="/users/logoutUser"><button class="p-2 px-4 rounded-lg border-2 border-orange-600 ml-4">Logout</button></a>
      </div>
    </div>
    
  </div>
  <div class="text-[#252422] grid grid-cols-1 justify-items-center my-10">
    <div class="text-4xl font-bold mb-3">Hello <%= user.username %></div>
    <div class="text-lg font-semibold">You can join the Auction by entering through this designated access point.</div>
  </div>
  <div class="flex justify-evenly mx-24 gap-10 mt-12">
    <% if (associatedAuctions.includes('nupl')) { %>
      <!-- Card for NUPL -->
      <div class="grid grid-cols-1 justify-items-center bg-white h-100 w-90 border-4 border-[#EB5E28]/50 rounded-lg p-6 shadow-2xl">
        <div class="h-80 w-80">
          <img src="../imgs/nupl.jpg" class="object-fit rounded-lg w-80 h-80 shadow-2xl" />
        </div>
        <a href="/users/nupl"><button class="mt-4 w-80 h-12 bg-[#403D39] text-[#FFFCF2] self-end rounded-lg font-semibold text-lg">Enter</button></a>
      </div>
    <% } %>
    
    <% if (associatedAuctions.includes('impetus')) { %>
      <!-- Card for Impetus -->
      <div class="grid grid-cols-1 justify-items-center bg-white h-100 w-90 border-4 border-[#EB5E28]/50 rounded-lg p-6 shadow-2xl">
        <div class="h-80 w-80">
          <img src="../imgs/impetus.jpg" class="object-fit rounded-lg w-80 h-80 shadow-2xl" />
        </div>
        <a href="/users/impetus"><button class="mt-4 w-80 h-12 bg-[#403D39] text-[#FFFCF2] self-end rounded-lg font-semibold text-lg">Enter</button></a>
      </div>
    <% } %>
    
    <% if (associatedAuctions.includes('futsal')) { %>
      <!-- Card for Futsal -->
      <div class="grid grid-cols-1 justify-items-center bg-white h-100 w-90 border-4 border-[#EB5E28]/50 rounded-lg p-6 shadow-2xl">
        <div class="h-80 w-80">
          <img src="../imgs/futsal.jpg" class="object-fit rounded-lg w-80 h-80 shadow-2xl" />
        </div>
        <a href="/users/futsal"><button class="mt-4 w-80 h-12 bg-[#403D39] text-[#FFFCF2] self-end rounded-lg font-semibold text-lg">Enter</button></a>
      </div>
    <% } %>
    
    <% if (associatedAuctions.includes('nukl')) { %>
      <!-- Card for Kabaddi -->
      <div class="grid grid-cols-1 justify-items-center bg-white h-100 w-90 border-4 border-[#EB5E28]/50 rounded-lg p-6 shadow-2xl">
        <div class="h-80 w-80">
          <img src="../imgs/kabaddi.jpg" class="object-fit rounded-lg w-80 h-80 shadow-2xl" />
        </div>
        <a href="/users/nukl"><button class="mt-4 w-80 h-12 bg-[#403D39] text-[#FFFCF2] self-end rounded-lg font-semibold text-lg">Enter</button></a>
      </div>
    <% } %>
  </div>
  <script>
    // Check for auctionEnded query parameter
    const params = new URLSearchParams(window.location.search);
    if (params.get('auctionEnded') === 'true') {
      const overlay = document.getElementById('auction-ended-overlay');
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');
      history.replaceState(null, '', '/users');
    }
  </script>
</body>
</html>
