    <a href="/host/manageusers"><button class="w-80 h-40 bg-[#403D39] text-[#FFFCF2] rounded-lg font-semibold text-3xl">Manage Users</button>
    </a>
    <a href="/host/newhost"><button class="w-80 h-40 bg-[#403D39] text-[#FFFCF2] rounded-lg font-semibold text-3xl">New Host</button>
    </a>
    <a href=""><button class="w-80 h-40 bg-[#403D39] text-[#FFFCF2] rounded-lg font-semibold text-3xl">Set Auction Time</button>
    </a>
    <a href=""><button class="w-80 h-40 bg-[#403D39] text-[#FFFCF2] rounded-lg font-semibold text-3xl">Auction Players</button>
    </a>
    <a href=""><button class="w-80 h-40 bg-[#403D39] text-[#FFFCF2] rounded-lg font-semibold text-3xl">Add new Players</button>
    </a>
  </div>
