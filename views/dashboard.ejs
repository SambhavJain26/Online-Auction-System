<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - Online Auction System</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-[#F8FAFC] min-h-screen flex flex-col justify-between">

  <!-- Header -->
  <header class="w-full bg-[#1E293B] text-white px-8 py-4 flex justify-between items-center shadow-md">
    <div class="flex items-center gap-6">
      <div class="flex items-center gap-3">
        <img src="/imgs/nu logo.png" alt="Logo" class="w-10 h-10 object-contain rounded-lg">
        <span class="font-extrabold text-xl tracking-tight text-white">AUCTION PORTAL</span>
      </div>
      <div class="hidden sm:flex items-center gap-2">
        <a href="/host" class="px-3.5 py-1.5 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-lg font-medium text-xs transition">
          Host Hub
        </a>
        <a href="/host/dashboard" class="px-3.5 py-1.5 bg-[#EB5E28] text-white rounded-lg font-semibold text-xs transition">
          Admin Dashboard
        </a>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <a href="/host/logoutHost" class="px-3.5 py-1.5 bg-slate-800 hover:bg-rose-900/60 text-rose-300 hover:text-white border border-slate-700 rounded-lg font-medium text-xs transition">
        Logout
      </a>
    </div>
  </header>

  <!-- Main Administrative Grid -->
  <main class="max-w-6xl mx-auto px-6 py-10 flex-1 w-full">
    <div class="mb-10 text-center max-w-xl mx-auto">
      <span class="inline-block px-3 py-1 bg-orange-100 text-[#EB5E28] text-xs font-bold rounded-full mb-2 uppercase tracking-wider">
        System Administration
      </span>
      <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">League Commissioner Dashboard</h2>
      <p class="text-slate-500 text-sm mt-1">Configure franchise accounts, add draft athletes, and manage league auction parameters.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

      <!-- Add Users -->
      <a href="/host/adduser" class="bg-white border border-slate-200 hover:border-emerald-500 rounded-2xl p-6 shadow-sm hover:shadow-lg transition-all duration-200 flex flex-col justify-between group">
        <div>
          <div class="w-12 h-12 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition">
            👥
          </div>
          <h3 class="text-lg font-extrabold text-slate-900 group-hover:text-emerald-600 transition">Register Franchise User</h3>
          <p class="text-slate-500 text-xs mt-1.5 leading-relaxed">Create new franchise accounts, allocate team purse budgets, and assign league access permissions.</p>
        </div>
        <div class="mt-6 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-emerald-600">
          <span>Add Franchise</span>
          <span>&rarr;</span>
        </div>
      </a>

      <!-- Manage Users -->
      <a href="/host/manageusers" class="bg-white border border-slate-200 hover:border-blue-500 rounded-2xl p-6 shadow-sm hover:shadow-lg transition-all duration-200 flex flex-col justify-between group">
        <div>
          <div class="w-12 h-12 rounded-xl bg-blue-50 border border-blue-200 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition">
            📋
          </div>
          <h3 class="text-lg font-extrabold text-slate-900 group-hover:text-blue-600 transition">Manage Franchises</h3>
          <p class="text-slate-500 text-xs mt-1.5 leading-relaxed">Review all registered team franchises, audit current budget balances, or revoke franchise access.</p>
        </div>
        <div class="mt-6 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-blue-600">
          <span>View All Franchises</span>
          <span>&rarr;</span>
        </div>
      </a>

      <!-- Add Players -->
      <a href="/host/newplayer" class="bg-white border border-slate-200 hover:border-amber-500 rounded-2xl p-6 shadow-sm hover:shadow-lg transition-all duration-200 flex flex-col justify-between group">
        <div>
          <div class="w-12 h-12 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition">
            ⭐
          </div>
          <h3 class="text-lg font-extrabold text-slate-900 group-hover:text-amber-600 transition">Add Draft Athletes</h3>
          <p class="text-slate-500 text-xs mt-1.5 leading-relaxed">Register new prospective athletes, upload avatar images, specify playing roles, and tag sport leagues.</p>
        </div>
        <div class="mt-6 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-amber-600">
          <span>Create Athlete Profile</span>
          <span>&rarr;</span>
        </div>
      </a>

      <!-- Manage Players -->
      <a href="/host/manageplayers" class="bg-white border border-slate-200 hover:border-purple-500 rounded-2xl p-6 shadow-sm hover:shadow-lg transition-all duration-200 flex flex-col justify-between group">
        <div>
          <div class="w-12 h-12 rounded-xl bg-purple-50 border border-purple-200 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition">
            🏆
          </div>
          <h3 class="text-lg font-extrabold text-slate-900 group-hover:text-purple-600 transition">Manage League Athletes</h3>
          <p class="text-slate-500 text-xs mt-1.5 leading-relaxed">Inspect the active candidate pools for NUPL Cricket, Impetus, Futsal, and NUKL Kabaddi leagues.</p>
        </div>
        <div class="mt-6 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-purple-600">
          <span>Roster Manager</span>
          <span>&rarr;</span>
        </div>
      </a>

      <!-- New Host -->
      <a href="/host/newhost" class="bg-white border border-slate-200 hover:border-slate-500 rounded-2xl p-6 shadow-sm hover:shadow-lg transition-all duration-200 flex flex-col justify-between group">
        <div>
          <div class="w-12 h-12 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition">
            ⚙️
          </div>
          <h3 class="text-lg font-extrabold text-slate-900 group-hover:text-slate-600 transition">Commissioner Settings</h3>
          <p class="text-slate-500 text-xs mt-1.5 leading-relaxed">Update administrative credentials, commissioner display name, and root profile security settings.</p>
        </div>
        <div class="mt-6 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-slate-600">
          <span>Edit Credentials</span>
          <span>&rarr;</span>
        </div>
      </a>

      <!-- Logout -->
      <a href="/host/logoutHost" class="bg-white border border-slate-200 hover:border-rose-400 rounded-2xl p-6 shadow-sm hover:shadow-lg transition-all duration-200 flex flex-col justify-between group">
        <div>
          <div class="w-12 h-12 rounded-xl bg-rose-50 border border-rose-200 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition">
            🔒
          </div>
          <h3 class="text-lg font-extrabold text-slate-900 group-hover:text-rose-600 transition">Terminate Session</h3>
          <p class="text-slate-500 text-xs mt-1.5 leading-relaxed">Safely log out of the host administrative console and revoke active session cookies.</p>
        </div>
        <div class="mt-6 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-rose-600">
          <span>Sign Out</span>
          <span>&rarr;</span>
        </div>
      </a>

    </div>
  </main>

  <footer class="w-full py-4 text-center text-xs text-slate-400 border-t border-slate-200 bg-white">
    Online Auction System &bull; Real-Time League Bidding Platform
  </footer>

</body>
</html>
