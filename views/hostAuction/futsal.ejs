<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Host Console - Futsal Auction</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-[#F8FAFC] min-h-screen">

  <!-- Header -->
  <header class="flex justify-between items-center px-8 py-4 bg-[#1E293B] text-white shadow-md">
    <div class="flex items-center gap-4">
      <a href="/host" class="px-4 py-2 bg-[#EB5E28] hover:bg-[#d44f1c] text-white font-semibold rounded-lg text-sm transition shadow-sm">
        &larr; Back to Hub
      </a>
      <span class="text-slate-400">|</span>
      <h1 class="text-xl font-extrabold tracking-tight">Futsal Live Auction Control Console</h1>
    </div>
    <span class="px-3 py-1 bg-amber-500/20 text-amber-300 border border-amber-500/30 rounded-full text-xs font-bold uppercase tracking-wider">
      Live Room
    </span>
  </header>

  <!-- Auction Arena Layout -->
  <main class="max-w-7xl mx-auto px-6 py-8 flex flex-col lg:flex-row gap-8">

    <!-- Left: Available Candidates Roster -->
    <section class="flex-1 bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-6">
        <div>
          <h2 class="text-xl font-bold text-slate-900">Eligible Auction Candidates</h2>
          <p class="text-slate-500 text-xs mt-0.5">Click "Nominate Athlete" to place them onto the live bidding block.</p>
        </div>
        <span class="text-xs font-bold px-3 py-1 bg-slate-100 text-slate-700 rounded-full">
          <%= futsal.length %> Athletes Remaining
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" id="hostPlayerList">
        <% futsal.forEach((player) => { %>
          <div class="bg-slate-50 border border-slate-200 hover:border-emerald-400 rounded-xl p-3.5 flex flex-col justify-between transition duration-200 hover:shadow-md" data-name="<%= player.name %>">
            <div>
              <div class="w-full h-40 rounded-lg overflow-hidden bg-slate-900 mb-3 border border-slate-200">
                <img class="w-full h-full object-cover" src="/imgs/uploads/<%= player.profilepic %>" onerror="this.src='/imgs/uploads/futsal_01.png'" alt="<%= player.name %>">
              </div>
              <h3 class="font-bold text-base text-slate-900"><%= player.name %></h3>
              <p class="text-slate-500 text-xs mt-1 leading-relaxed"><%= player.description %></p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-200 flex justify-center">
              <button class="sendPlayerBtn w-full bg-[#EB5E28] hover:bg-[#d44f1c] text-white py-2 px-3 rounded-lg font-bold text-xs tracking-wider uppercase shadow-sm transition" 
                data-id="<%= player._id %>" data-name="<%= player.name %>" data-description="<%= player.description %>" 
                data-image="<%= player.profilepic %>">
                Nominate Athlete &rarr;
              </button>
            </div>
          </div>
        <% }) %>
      </div>
    </section>

    <!-- Right: Real-Time Bidding Monitor -->
    <aside class="w-full lg:w-96 flex flex-col gap-6">

      <!-- Status Card -->
      <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-5">
        <h3 class="text-base font-bold text-slate-900 pb-2 border-b border-slate-100">Live Auction Telemetry</h3>

        <!-- Countdown Timer -->
        <div class="bg-rose-50 border border-rose-200 p-4 rounded-xl flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-rose-700">Time Remaining</span>
          <div class="text-2xl font-black text-rose-600">
            <span id="timer">10</span>s
          </div>
        </div>

        <!-- Current Bid -->
        <div class="bg-slate-900 text-white p-4 rounded-xl flex items-center justify-between shadow-sm">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Current Valuation</span>
          <div class="text-2xl font-extrabold text-amber-400">
            ₹<span id="current-bid">0</span>
          </div>
        </div>

        <!-- Winner / Unsold Announcement Banner -->
        <div id="winner-message-section" class="p-3 bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-bold text-center rounded-xl hidden">
        </div>

        <!-- Live Bid History Feed -->
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block mb-2">Live Bidding Log</span>
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-3.5 max-h-56 overflow-y-auto space-y-2 text-xs" id="bid-history">
            <p class="text-slate-400 text-center py-4">Awaiting first nomination...</p>
          </div>
        </div>

        <!-- End Session Button -->
        <button
          id="end-auction-button"
          class="w-full py-3 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs uppercase tracking-wider rounded-xl shadow-sm transition"
        >
          Close Auction Room
        </button>
      </div>

    </aside>

  </main>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io('/host/futsal');

    document.querySelectorAll('.sendPlayerBtn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const playerData = {
          id: btn.dataset.id,
          name: btn.dataset.name,
          description: btn.dataset.description,
          image: btn.dataset.image
        };

        socket.emit('shareSelectedPlayer', playerData); 

        const playerDiv = btn.closest('div[data-name]');
        if (playerDiv) playerDiv.remove();
      });
    });

    document.getElementById('end-auction-button').addEventListener('click', () => {
      if (confirm('Are you sure you want to end this auction session?')) {
        socket.emit('endAuction'); 
      }
    });

    socket.on('timerUpdate', (timer) => {
      document.getElementById('timer').innerText = timer;
    });

    socket.on('currentBidUpdate', (bid) => {
      document.getElementById('current-bid').innerText = `${bid}`;
    });

    socket.on('bidHistoryUpdate', (history) => {
      const historyContainer = document.getElementById('bid-history');
      historyContainer.innerHTML = ''; 
      
      if (history.length === 0) {
        historyContainer.innerHTML = '<p class="text-slate-400 text-center py-2">No bids recorded yet.</p>';
        return;
      }

      history.forEach(({ username, amount }) => {
        const entry = document.createElement('div');
        entry.className = 'py-1 px-2 rounded bg-white border border-slate-100 flex justify-between items-center';
        if (amount === "Passed") {
          entry.innerHTML = `<span class="font-medium text-slate-600">${username}</span> <span class="text-rose-500 font-bold">Passed</span>`;
        } else {
          entry.innerHTML = `<span class="font-medium text-slate-800">${username}</span> <span class="text-emerald-600 font-bold">₹${amount}</span>`;
        }
        historyContainer.appendChild(entry);
      });
      historyContainer.scrollTop = historyContainer.scrollHeight;
    });

    socket.on('announceWinner', ({ username, player }) => {
      const winnerMessageSection = document.getElementById('winner-message-section');
      winnerMessageSection.innerText = `SOLD: ${username} acquired ${player}!`;
      winnerMessageSection.classList.remove('hidden'); 
    });

    socket.on('unsoldPlayer', ({ player }) => {
      const winnerMessageSection = document.getElementById('winner-message-section');
      winnerMessageSection.innerText = `UNSOLD: ${player} passed by all franchises.`;
      winnerMessageSection.classList.remove('hidden');
    });

    socket.on('resetWinner', () => {
      const winnerMessageSection = document.getElementById('winner-message-section');
      winnerMessageSection.classList.add('hidden'); 
      winnerMessageSection.innerText = ''; 
    });
  </script>

</body>
</html>
