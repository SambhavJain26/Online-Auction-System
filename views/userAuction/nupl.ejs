<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NUPL Cricket Live Arena - Franchise Terminal</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-[#F8FAFC] min-h-screen flex flex-col justify-between relative">

  <!-- Winner Modal Overlay -->
  <div id="winner-overlay" class="hidden fixed inset-0 bg-slate-900/80 backdrop-blur-sm text-white flex items-center justify-center text-center z-[9999]">
    <div class="bg-slate-800 border-2 border-amber-400 p-8 rounded-2xl max-w-md shadow-2xl transform scale-105 transition">
      <div class="text-5xl mb-3">🔨 SOLD!</div>
      <h2 class="text-2xl font-black text-amber-400" id="winner-message"></h2>
      <p class="mt-2 text-xs text-slate-300">Contract finalized and logged into the franchise ledger.</p>
      <button onclick="document.getElementById('winner-overlay').classList.add('hidden')" class="mt-6 px-6 py-2 bg-amber-500 hover:bg-amber-600 text-slate-900 rounded-xl font-bold text-xs uppercase tracking-wider transition">
        Continue
      </button>
    </div>
  </div>

  <!-- Header -->
  <header class="flex justify-between items-center px-8 py-4 bg-[#1E293B] text-white shadow-md">
    <div class="flex items-center gap-4">
      <a href="/users" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white font-semibold rounded-lg text-xs transition">
        &larr; Exit to Hub
      </a>
      <span class="text-slate-400">|</span>
      <h1 class="text-lg font-extrabold tracking-tight">NUPL Live Arena</h1>
    </div>

    <!-- Franchise Info -->
    <div class="flex items-center gap-6">
      <div class="text-right">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block">Franchise Purse</span>
        <span class="text-lg font-black text-emerald-400">₹<span id="user-budget"><%= userBalance %></span></span>
      </div>
      <span class="px-3 py-1 bg-amber-500/20 text-amber-300 border border-amber-500/30 rounded-full text-xs font-bold uppercase">
        Live
      </span>
    </div>
  </header>

  <!-- Live Arena Main -->
  <main class="max-w-5xl mx-auto px-6 py-8 flex-1 w-full">

    <!-- Top Telemetry Bar -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
      
      <!-- Timer -->
      <div class="bg-rose-50 border border-rose-200 p-4 rounded-2xl flex items-center justify-between shadow-sm">
        <div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-rose-700 block">Hammer Countdown</span>
          <span class="text-xs text-rose-500">Resets on every valid bid</span>
        </div>
        <div class="text-3xl font-black text-rose-600 tracking-tight">
          <span id="timer">10</span>s
        </div>
      </div>

      <!-- Current Valuation -->
      <div class="bg-slate-900 text-white p-4 rounded-2xl flex items-center justify-between shadow-sm">
        <div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block">Current High Bid</span>
          <span class="text-xs text-amber-300">Live authoritative valuation</span>
        </div>
        <div class="text-3xl font-black text-amber-400 tracking-tight" id="current-bid">
          ₹0
        </div>
      </div>

      <!-- Your Franchise Status -->
      <div class="bg-white border border-slate-200 p-4 rounded-2xl flex items-center justify-between shadow-sm">
        <div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block">Franchise Identity</span>
          <span class="text-sm font-extrabold text-slate-800"><%= username %></span>
        </div>
        <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
      </div>

    </div>

    <!-- Candidate & Bidding Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">

      <!-- Center Left: Active Athlete Card -->
      <div class="lg:col-span-2 bg-white border border-slate-200 rounded-2xl p-8 shadow-sm flex flex-col items-center justify-center min-h-[420px]" id="player-container">
        <div class="text-center py-12">
          <div class="w-20 h-20 rounded-2xl bg-slate-100 border border-slate-200 flex items-center justify-center text-4xl mx-auto mb-4">
            🏏
          </div>
          <h3 class="text-xl font-bold text-slate-800">Waiting for Next Candidate</h3>
          <p class="text-slate-500 text-xs mt-1.5 max-w-sm mx-auto leading-relaxed">
            The league auctioneer will present the next athlete on the bidding block shortly. Prepare your valuation strategy.
          </p>
        </div>
      </div>

      <!-- Right: Action Terminal & History -->
      <div class="space-y-6">

        <!-- Action Buttons Card -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Bid Action Controls</h4>
          
          <button id="bid-button" class="w-full py-4 bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-base uppercase tracking-wider rounded-xl shadow-md transition transform active:scale-95 flex items-center justify-center gap-2">
            <span>⚡</span> Place Higher Bid
          </button>
          
          <button id="pass-button" class="w-full py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs uppercase tracking-wider rounded-xl transition">
            Pass on Athlete
          </button>
        </div>

        <!-- Bid History Card -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
          <div class="flex items-center justify-between pb-2 border-b border-slate-100 mb-3">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">Live Bidding Log</h4>
            <span class="text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded">Real-Time</span>
          </div>
          <div id="bid-history" class="max-h-48 overflow-y-auto space-y-2 text-xs">
            <p class="text-slate-400 text-center py-4">Waiting for bids...</p>
          </div>
        </div>

      </div>

    </div>

  </main>

  <footer class="w-full py-3 text-center text-[11px] text-slate-400 border-t border-slate-200 bg-white">
    Online Auction System &bull; Franchise Live Bidding Session
  </footer>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io('/users/nupl');

    let currentBid = 0;
    let biddingEnabled = false;
    let userBudget = parseInt(document.getElementById('user-budget').innerText, 10) || 1500000;

    document.getElementById('pass-button').addEventListener('click', () => {
      socket.emit("pass", "<%= userId %>");
    });

    document.getElementById('bid-button').addEventListener('click', () => {
      placeBid("<%= userId %>");
    });

    function calculateNextBid() {
      if (currentBid === 0) {
        return 3000; 
      } else if (currentBid < 10000) {
        return currentBid + 500; 
      } else {
        return currentBid + 1000; 
      }
    }

    function updateCurrentBid(bid) {
      document.getElementById('current-bid').innerText = `₹${bid}`;
      currentBid = bid;
    }

    function placeBid(userId) {
      if (!biddingEnabled) {
        alert("Bidding is not allowed at this time.");
        return;
      }
      const newBid = calculateNextBid();
      if (userBudget < newBid) {
        alert("Your remaining budget is insufficient for this bid.");
        return;
      }

      socket.emit('placeBid', { userId, newBid });
    }

    function renderBidHistory(history) {
      const historyContainer = document.getElementById('bid-history');
      historyContainer.innerHTML = '';

      if (history.length === 0) {
        historyContainer.innerHTML = '<p class="text-slate-400 text-center py-3">No bids placed yet.</p>';
        return;
      }

      history.forEach(({ username, amount }) => {
        const entry = document.createElement('div');
        entry.className = 'py-1 px-2 rounded bg-slate-50 border border-slate-100 flex justify-between items-center';
        if (amount === "Passed") {
          entry.innerHTML = `<span class="font-medium text-slate-600">${username}</span> <span class="text-rose-500 font-bold">Passed</span>`;
        } else {
          entry.innerHTML = `<span class="font-medium text-slate-900">${username}</span> <span class="text-emerald-600 font-bold">₹${amount}</span>`;
        }
        historyContainer.appendChild(entry);
      });
      historyContainer.scrollTop = historyContainer.scrollHeight;
    }

    function renderPlayer(playerData) {
      const playerContainer = document.getElementById('player-container');
      if (!playerData || !playerData.name) return;

      const playerCard = `
        <div class="w-full flex flex-col items-center">
          <div class="w-56 h-60 rounded-xl overflow-hidden bg-slate-900 border-2 border-slate-200 mb-4 shadow-sm">
            <img src="/imgs/uploads/${playerData.image || 'cricket_01.png'}" onerror="this.src='/imgs/uploads/sample_athlete.png'" alt="${playerData.name}" class="w-full h-full object-cover">
          </div>
          <div class="text-center">
            <span class="inline-block px-3 py-1 bg-amber-50 text-amber-700 border border-amber-200 text-xs font-bold rounded-full mb-2 uppercase tracking-wider">Candidate on the Block</span>
            <h3 class="text-2xl font-extrabold text-slate-900">${playerData.name}</h3>
            <p class="text-slate-500 text-xs mt-1 max-w-sm mx-auto leading-relaxed">${playerData.description}</p>
          </div>
        </div>
      `;

      playerContainer.innerHTML = playerCard;
    }

    fetch('/api/current-player')
      .then(response => response.json())
      .then(playerData => {
        if (playerData.name) {
          renderPlayer(playerData); 
        }
      })
      .catch(err => console.log(err));

    socket.on('receiveSelectedPlayer', (playerData) => {
      renderPlayer(playerData); 
    });

    socket.on('currentBidUpdate', (bid) => {
      updateCurrentBid(bid);
    });

    socket.on('bidHistoryUpdate', (history) => {
      renderBidHistory(history);
    });

    socket.on('timerUpdate', (timer) => {
      document.getElementById('timer').innerText = timer;
    });

    socket.on('biddingStatusUpdate', (status) => {
      biddingEnabled = status;
      const bidBtn = document.getElementById('bid-button');
      if (biddingEnabled) {
        bidBtn.classList.remove('opacity-50', 'cursor-not-allowed');
      } else {
        bidBtn.classList.add('opacity-50', 'cursor-not-allowed');
      }
    });

    socket.on('passButtonStatus', (status) => {
      const passBtn = document.getElementById('pass-button');
      if (status) {
        passBtn.classList.remove('opacity-50', 'cursor-not-allowed');
      } else {
        passBtn.classList.add('opacity-50', 'cursor-not-allowed');
      }
    });

    socket.on('announceWinner', ({ username, player }) => {
      const winnerOverlay = document.getElementById('winner-overlay');
      const winnerMessage = document.getElementById('winner-message');
      winnerMessage.innerText = `${username} won ${player} for ₹${currentBid}!`;
      winnerOverlay.classList.remove('hidden');

      if (username === "<%= username %>") {
        userBudget -= currentBid;
        document.getElementById('user-budget').innerText = `${userBudget}`;
      }
    });

    socket.on('unsoldPlayer', ({ player }) => {
      const winnerOverlay = document.getElementById('winner-overlay');
      const winnerMessage = document.getElementById('winner-message');
      winnerMessage.innerText = `Athlete ${player} was Unsold (All Passed)`;
      winnerOverlay.classList.remove('hidden');
    });

    socket.on('resetWinner', () => {
      document.getElementById('winner-overlay').classList.add('hidden');
    });

    socket.on('auctionEnded', ({ message }) => {
      document.getElementById('auction-ended-overlay').classList.remove('hidden');
    });
  </script>

</body>
</html>
