<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/login.css">
    <title>Sports Auction Arena - Authentication Portal</title>
</head>

<body>
    <div class="container" id="container">
        <div class="form-container sign-up">
            <form action="/loginHost" method="post">
                <h1>Host Portal</h1>
                <p style="margin: 4px 0 16px 0; color: #64748b; font-size: 13px;">Sign in with your auctioneer credentials</p>
                <input type="email" name="email" placeholder="Email (e.g. host@nupl.com)" required>
                <input type="password" name="password" placeholder="Password" required>
                <button type="submit">Sign In as Host</button>
            </form>
        </div>
        <div class="form-container sign-in">
            <form action="/loginUser" method="post">
                <h1>Franchise Portal</h1>
                <p style="margin: 4px 0 16px 0; color: #64748b; font-size: 13px;">Sign in with your team franchise credentials</p>
                <input type="email" name="email" placeholder="Email (e.g. user@nupl.com)" required>
                <input type="password" name="password" placeholder="Password" required>
                <button type="submit">Sign In as Franchise</button>
            </form>
        </div>
        <div class="toggle-container">
            <div class="toggle">
                <div class="toggle-panel toggle-left">
                  <h1>Team Franchise</h1>
                  <p>Bidding for athletes in the live auction? Switch to the franchise portal.</p>
                  <button class="hidden" id="login">Franchise Login</button>
                </div>
                <div class="toggle-panel toggle-right">
                    <h1>Auction Host</h1>
                    <p>Managing athletes, conducting rounds, and controlling the hammer? Switch to the host portal.</p>
                    <button class="hidden" id="register">Host Login</button>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/script.js"></script>
</body>

</html>
