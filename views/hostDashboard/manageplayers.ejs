<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="../css/style.css">
</head>
<body>
  <a href="/host/dashboard"><button class=" border-2 border-black rounded-lg m-6">Go Back</button></a>
  <div class="flex justify-evenly">
    <div class="h-full w-full p-2 border-2 mr-3 ml-6 my-3 border-black rounded-md">
      <h1 class="text-center text-3xl font-bold">IMPETUS</h1>
      <% impetus.forEach((player)=>{ %>
        <div class="w-72 p-4 bg-slate-400 mb-3 rounded-lg">
          <p><%= player.name %></p>
          <p><%= player.description %></p>
          <a class="text-red-500" href="/host/deleteplayer/<%= player._id %>">Delete player</a>
        </div>
      <% }) %>
    </div>
    <div class="h-full w-full p-2 border-2 m-3 border-black rounded-md">
      <h1 class="text-center text-3xl font-bold">NUPL</h1>
      <% nupl.forEach((player)=>{ %>
        <div class="w-72 p-4 bg-slate-400 mb-3 rounded-lg">
          <p><%= player.name %></p>
          <p><%= player.description %></p>
          <a class="text-red-500" href="/host/deleteplayer/<%= player._id %>">Delete player</a>
        </div>
      <% }) %>
    </div>
    <div class="h-full w-full p-2 border-2 m-3 border-black rounded-md">
      <h1 class="text-center text-3xl font-bold">FUTSAL</h1>
      <% futsal.forEach((player)=>{ %>
        <div class="w-72 p-4 bg-slate-400 mb-3 rounded-lg">
          <p><%= player.name %></p>
          <p><%= player.description %></p>
          <a class="text-red-500" href="/host/deleteplayer/<%= player._id %>">Delete player</a>
        </div>
      <% }) %>
    </div>
    <div class="h-full w-full p-2 border-2 ml-3 mr-6 my-3 border-black rounded-md">
      <h1 class="text-center text-3xl font-bold">NUKL</h1>
      <% nukl.forEach((player)=>{ %>
        <div class="w-72 p-4 bg-slate-400 mb-3 rounded-lg">
          <p><%= player.name %></p>
          <p><%= player.description %></p>
          <a class="text-red-500" href="/host/deleteplayer/<%= player._id %>">Delete player</a>
        </div>
      <% }) %>
    </div>
  </div>
</html>