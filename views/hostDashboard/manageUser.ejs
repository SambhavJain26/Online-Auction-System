<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Management</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#f9fafb]">

  <!-- Go Back Button -->
  <div class="flex justify-between items-center px-6 py-4 bg-[#403D39] text-white">
    <a href="/host/dashboard">
      <button class="px-4 py-2 bg-orange-500 rounded-lg font-bold hover:bg-orange-600 transition duration-300">Go Back</button>
    </a>
  </div>

  <!-- User List Section -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8 px-6 py-8">
    <% users.forEach((user) => { %>
      <div class="w-full p-6 bg-slate-400 rounded-lg shadow-lg transition-all duration-300 hover:shadow-xl">
        <!-- Profile Picture -->
        <div class="w-36 h-36 rounded-full overflow-hidden mb-6 mx-auto border-4 border-orange-500">
          <img class="w-full h-full object-cover" src="../imgs/uploads/<%= user.profilepic %>" alt="<%= user.username %>">
        </div>
        
        <!-- Username -->
        <p class="text-2xl font-semibold text-center text-[#2D3748] mb-2"><%= user.username %></p>
        
        <!-- Email -->
        <p class="text-lg text-center text-gray-700 mb-4"><%= user.email %></p>
        
        <!-- Delete User Link -->
        <div class="flex justify-center">
          <a class="text-red-500 hover:underline font-semibold text-lg" href="/host/deleteuser/<%= user._id %>">Delete User</a>
        </div>
      </div>
    <% }) %>
  </div>

</body>
</html>
