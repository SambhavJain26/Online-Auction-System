<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register Franchise User - Online Auction System</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-[#F8FAFC] min-h-screen flex flex-col justify-between">

  <!-- Header -->
  <header class="flex justify-between items-center px-8 py-4 bg-[#1E293B] text-white shadow-md">
    <div class="flex items-center gap-4">
      <a href="/host/dashboard" class="px-4 py-2 bg-[#EB5E28] hover:bg-[#d44f1c] text-white font-semibold rounded-lg text-xs transition shadow-sm">
        &larr; Back to Dashboard
      </a>
      <span class="text-slate-400">|</span>
      <h1 class="text-xl font-bold tracking-tight text-white">Register Franchise User</h1>
    </div>
  </header>

  <!-- Form Section -->
  <main class="max-w-xl mx-auto my-8 p-8 bg-white border border-slate-200 rounded-2xl shadow-sm flex-1 w-full">
    <div class="text-center mb-6">
      <span class="inline-block px-3 py-1 bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-bold rounded-full mb-2 uppercase tracking-wider">
        Franchise Onboarding
      </span>
      <h2 class="text-2xl font-extrabold text-slate-900">Add Team Franchise</h2>
      <p class="text-slate-500 text-xs mt-1">Create credentials and assign tournament purse budgets.</p>
    </div>

    <form action="/host/add" method="post" enctype="multipart/form-data" class="space-y-4">

      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Franchise Name</label>
        <input type="text" name="username" placeholder="e.g. Apex Titans" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#EB5E28] focus:bg-white transition" required>
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Owner Email</label>
        <input type="email" name="email" placeholder="franchise@nupl.com" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#EB5E28] focus:bg-white transition" required>
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Secure Password</label>
        <input type="password" name="password" placeholder="••••••••" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#EB5E28] focus:bg-white transition" required>
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Franchise Logo / Avatar (Optional)</label>
        <input type="file" name="image" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-500 focus:outline-none">
      </div>

      <!-- Tournament Allotment -->
      <div class="pt-2">
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-3">Participating Leagues & Budgets:</label>

        <div class="space-y-2.5 bg-slate-50 p-4 rounded-xl border border-slate-200">
          
          <!-- NUPL -->
          <div class="flex items-center justify-between">
            <label class="flex items-center gap-2 cursor-pointer text-sm font-semibold text-slate-800">
              <input type="checkbox" name="auction" value="nupl" onchange="toggleBudget('nupl')" class="rounded text-[#EB5E28] focus:ring-[#EB5E28]">
              <span>NUPL Cricket</span>
            </label>
            <input type="number" name="budget_nupl" placeholder="Purse (₹)" id="budget_nupl" class="p-2 text-xs bg-white border border-slate-200 rounded-lg w-36 hidden focus:outline-none focus:ring-1 focus:ring-[#EB5E28]" min="0">
          </div>

          <!-- Impetus -->
          <div class="flex items-center justify-between">
            <label class="flex items-center gap-2 cursor-pointer text-sm font-semibold text-slate-800">
              <input type="checkbox" name="auction" value="impetus" onchange="toggleBudget('impetus')" class="rounded text-[#EB5E28] focus:ring-[#EB5E28]">
              <span>IMPETUS Esports</span>
            </label>
            <input type="number" name="budget_impetus" placeholder="Purse (₹)" id="budget_impetus" class="p-2 text-xs bg-white border border-slate-200 rounded-lg w-36 hidden focus:outline-none focus:ring-1 focus:ring-[#EB5E28]" min="0">
          </div>

          <!-- Futsal -->
          <div class="flex items-center justify-between">
            <label class="flex items-center gap-2 cursor-pointer text-sm font-semibold text-slate-800">
              <input type="checkbox" name="auction" value="futsal" onchange="toggleBudget('futsal')" class="rounded text-[#EB5E28] focus:ring-[#EB5E28]">
              <span>Futsal</span>
            </label>
            <input type="number" name="budget_futsal" placeholder="Purse (₹)" id="budget_futsal" class="p-2 text-xs bg-white border border-slate-200 rounded-lg w-36 hidden focus:outline-none focus:ring-1 focus:ring-[#EB5E28]" min="0">
          </div>

          <!-- NUKL -->
          <div class="flex items-center justify-between">
            <label class="flex items-center gap-2 cursor-pointer text-sm font-semibold text-slate-800">
              <input type="checkbox" name="auction" value="nukl" onchange="toggleBudget('nukl')" class="rounded text-[#EB5E28] focus:ring-[#EB5E28]">
              <span>NUKL Kabaddi</span>
            </label>
            <input type="number" name="budget_nukl" placeholder="Purse (₹)" id="budget_nukl" class="p-2 text-xs bg-white border border-slate-200 rounded-lg w-36 hidden focus:outline-none focus:ring-1 focus:ring-[#EB5E28]" min="0">
          </div>

        </div>
      </div>

      <div class="pt-4">
        <button type="submit" class="w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs uppercase tracking-wider rounded-xl shadow-sm transition">
          Confirm & Register Franchise
        </button>
      </div>

    </form>
  </main>

  <footer class="w-full py-3 text-center text-xs text-slate-400 border-t border-slate-200 bg-white">
    Online Auction System &bull; Host Administration
  </footer>

  <script>
    function toggleBudget(auction) {
      const budgetInput = document.getElementById(`budget_${auction}`);
      budgetInput.classList.toggle('hidden');
    }
  </script>

</body>
</html>
